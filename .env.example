# Explicit demo: simulated route, position and incidents around Casablanca.
EXPO_PUBLIC_DEMO_MODE=true
# Public Mapbox token (pk.*), never a secret token.
EXPO_PUBLIC_MAPBOX_TOKEN=
# HTTPS URL of the provided community server; leave empty to disable community alerts.
EXPO_PUBLIC_ALERTS_URL=
# Native Android map key, restricted to package + signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=
